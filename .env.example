# From Google Cloud Console -> APIs & Services -> Credentials -> your OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client
REDIRECT_URI=http://localhost:8765/

# Optional tuning
#SYNC_INTERVAL_MIN=30
#BACKFILL_DAYS=30
#LOOKBACK_HOURS=48
#TZ=America/New_York
# Restrict to some types (space or comma separated), default = all supported by Fitbit Air
#DATA_TYPES=steps heart-rate sleep daily-resting-heart-rate
